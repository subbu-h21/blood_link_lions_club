# Same hosted Supabase project as frontend/.env.local's
# NEXT_PUBLIC_SUPABASE_URL / SUPABASE_SECRET_KEY - no NEXT_PUBLIC_ prefix
# here since this tool is never bundled into a browser build. Server-only,
# same as every other direct-service-role script in this repo
# (frontend/scripts/*.mjs) - never commit the real values.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
