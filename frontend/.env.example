# Supabase (Unit 02/04). SUPABASE_SECRET_KEY is server-only, never exposed
# to the browser (CLAUDE.md rule 1). Uses the current sb_publishable_*/
# sb_secret_* key format, not the legacy anon/service_role JWTs - Unit 01
# used the old names, corrected in Unit 04 (see prompts/README.md).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Web Push / VAPID (Unit 18). The public key must reach the browser (the
# service worker's pushManager.subscribe() call needs it client-side),
# hence NEXT_PUBLIC_ - Unit 01's original bare VAPID_PUBLIC_KEY was never
# actually reachable client-side, corrected here (see prompts/README.md,
# same category as Unit 04's Supabase key rename). Exposing the public
# key is safe by design; VAPID_PRIVATE_KEY stays server-only always.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:PLACEHOLDER@example.org

# App
NEXT_PUBLIC_SITE_URL=

# Scheduled jobs (Unit 31). Server-only - checked against the
# `Authorization: Bearer <CRON_SECRET>` header the migration's pg_cron
# jobs send via pg_net (secret stored in Supabase Vault, not here or in
# any GUC - see the Unit 31 migration for why). Must match the
# `cron_secret` Vault entry for the environment the app is running
# against, or every /api/cron/* route rejects with 401.
CRON_SECRET=
